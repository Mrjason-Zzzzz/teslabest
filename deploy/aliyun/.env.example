# 域名与证书。首次验证建议使用 ali-test.dorezst.cn，验收后再改正式域名。
APP_DOMAIN=ali-test.dorezst.cn
ACME_EMAIL=replace-with-your-email@example.com
APP_IMAGE_TAG=p002

# 站点管理员。迁移时必须与现网保持一致，否则原管理账号无法登录。
USERNAME=replace-with-current-admin
PASSWORD=replace-with-current-admin-password
CRON_PASSWORD=replace-with-a-long-random-string
SITE_BASE=https://ali-test.dorezst.cn
NEXT_PUBLIC_SITE_NAME=Dorezst

# 第一阶段继续连接现网 Postgres，确认应用无误后再执行数据库独立迁移。
NEXT_PUBLIC_STORAGE_TYPE=postgres
POSTGRES_URL=postgresql://replace-with-current-postgres-url

# 播放代理与弹幕。令牌只写在服务器 .env，禁止提交到 Git。
NEXT_PUBLIC_PROXY_M3U8_TOKEN=replace-with-a-long-random-string
DANMAKU_API_BASE=https://danmu.dorezst.cn
DANMAKU_API_TOKEN=replace-with-danmaku-token

# 当前产品裁剪保持不变。
WATCH_ROOM_ENABLED=false
WATCH_ROOM_SERVER_TYPE=external
NEXT_PUBLIC_ENABLE_OFFLINE_DOWNLOAD=false
ENABLE_TVBOX_SUBSCRIBE=false

# 自托管进程可等待定时任务执行完毕。
CRON_WAIT_FOR_COMPLETION=true
DATA_MIGRATION_CHUNK_SIZE=10
NODE_OPTIONS=--max-old-space-size=2048
